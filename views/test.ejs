<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <!-- Bootstrap 5 CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <div class="container py-5">
    <!-- Header -->
    <header class="pb-3 mb-4 border-bottom">
      <span class="fs-4 fw-bold text-primary">Node.js Hosting Test</span>
    </header>

    <!-- Main Card -->
    <div class="p-5 mb-4 bg-white rounded-3 shadow-sm">
      <div class="container-fluid py-2">
        <h1 class="display-6 fw-bold text-dark"><%= title %></h1>
        <p class="col-md-8 fs-5 text-muted mt-3">
           테스트용 EJS 화일로서 git history 조회 테스트~~
        </p>
        
        <div class="mt-4 p-3 bg-light rounded border">
          <p class="mb-1"><strong>서버 상태:</strong> <span class="badge bg-success"><%= status %></span></p>
          <p class="mb-0"><strong>서버 응답 시간 (KST):</strong> <%= serverTime %></p>
        </div>
      </div>
    </div>

    <!-- Feature Section -->
    <div class="row align-items-md-stretch">
      <div class="col-md-6 mb-4">
        <div class="h-100 p-4 text-white bg-dark rounded-3 shadow-sm">
          <h4>포함된 주요 기능</h4>
          <ul class="mt-3">
            <% features.forEach(function(feature) { %>
              <li><%= feature %></li>
            <% }); %>
          </ul>
        </div>
      </div>
      <div class="col-md-6 mb-4">
        <div class="h-100 p-4 bg-white border rounded-3 shadow-sm">
          <h4>연동 테스트</h4>
          <p class="text-muted small">아래 버튼을 눌러 페이지를 새로고침하면 서버 시간이 갱신됩니다.</p>
          <button onclick="location.reload()" class="btn btn-outline-primary">페이지 새로고침</button>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="pt-3 mt-4 text-muted border-top text-center fs-7">
      &copy; 2026 Node.js Test Application
    </footer>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>